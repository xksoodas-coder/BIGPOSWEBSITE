# Copy these into Vercel → Project → Settings → Environment Variables.
# Never commit the real values.

# Turso database (same one DigiSoftApp pushes to).
# Example: libsql://bigsoft-sync-haithem.turso.io
TURSO_DATABASE_URL=

# Turso read/write auth token (create via: turso db tokens create <db-name>)
TURSO_AUTH_TOKEN=

# Random string used to sign customer session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BWS_SESSION_SECRET=

# Optional global session-revocation lever. Leave empty normally. To log EVERY
# customer/admin out at once (e.g. after a leak), set it to a new value (any
# string, e.g. an incrementing number "2", "3"...). All previously issued
# tokens become invalid immediately. No effect while empty.
BWS_SESSION_EPOCH=

# Pusher (real-time "new order" notification to the store's phones).
# The SECRET must come from env only — never hard-code it. The old hard-coded
# secret was leaked in git history; ROTATE it in the Pusher dashboard and set
# the new value here. If unset, order notifications are simply skipped.
PUSHER_SECRET=
# Optional overrides (these are public; safe defaults are used if unset):
# PUSHER_APP_ID=
# PUSHER_KEY=
# PUSHER_CLUSTER=eu
